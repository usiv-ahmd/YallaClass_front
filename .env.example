# Yalla Class frontend configuration (Vite).
# Copy this file to `.env` for local development. Never commit real credentials.

# "http" connects to the real Express backend; "mock" uses the in-browser mock providers.
VITE_API_MODE=http

# Backend base URL. The Express default port is 4000 and routes are mounted under /api.
VITE_API_BASE_URL=http://localhost:4000/api

# Socket.IO server origin. Configuration only in Phase 1; the socket is not connected yet.
VITE_SOCKET_URL=http://localhost:4000
